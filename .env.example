# Copy this file to .env (in the same directory) and fill in your real values.
# .env is gitignored -- never commit real credentials.
#
# API key for the on-prem LLM proxy at
# https://sberecognition.tzuchi-org.tw/functions/v1/llm-proxy/v1
# (OpenAI-compatible /chat/completions endpoint). Ask the infra team for a key.
LLM_PROXY_API_KEY=

# Drust tenant 9eec6c81-f435-4811-b86d-a4829edbecea tokens. Get these from
# the Drust admin console -- never hardcode them in config.py.
DRUST_ANON_TOKEN=
DRUST_SERVICE_TOKEN=
